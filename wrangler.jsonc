{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kura-escape-example",
  "compatibility_date": "2026-05-21",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "escape.kuracms.com", "custom_domain": true, "zone_name": "kuracms.com" }]
}
